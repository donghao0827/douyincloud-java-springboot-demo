# 抖音云控制台环境变量示例（不要把真实值提交到仓库）
PORT=8000
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=8000
DEEPSEEK_THINKING=false

# true 时完全不调模型；上线请设 false
AI_PAUSED=false

# 设置后 /api/action、/api/control、/api/ai/pause 需要 X-Kapu-Token
API_TOKEN=

# 台账/工资 JSONL 目录；云端建议挂持久化存储
DATA_DIR=data

# ---- 常驻内容工坊（开发期工具，云端建议关闭）----
ENABLE_BACKGROUND_AGENT=false
AGENT_WORK_START=09:00
AGENT_WORK_END=18:00
AGENT_WORK_DAYS=1,2,3,4,5,6,7
AGENT_TICK_SECONDS=300
AGENT_WORKSPACE=workspace
