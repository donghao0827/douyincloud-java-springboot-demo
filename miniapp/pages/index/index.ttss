page,.panel{height:100%;background:#fff8ed;color:#304936}
.content{padding:18px 20px 25px}
.heading,.footer{display:flex;align-items:center;justify-content:space-between}
.title{font-size:22px;font-weight:700}
.fruit{width:34px;height:34px}
.status{font-size:13px;color:#48684d;margin:3px 0 10px}
.boss-countdown{margin-bottom:14px;padding:6px 12px;font-size:13px;color:#b85c3a;background:#fff1e6;border-radius:8px;text-align:center}
.section{font-size:14px;font-weight:600;margin-bottom:8px}
.choices{display:flex;flex-wrap:wrap;justify-content:space-between}
.choice{box-sizing:border-box;width:32%;margin:0 0 8px;padding:0;background:#fffdf7;border:1px solid #d5c7a8;border-radius:12px;color:#344d3c;font-size:14px;line-height:40px}
.choice.active{background:#365740;color:#fff8e8;border-color:#365740}
.choice::after,.back::after{border:0}
.footer{min-height:33px}
.note{font-size:12px;color:#656c5c}
.back{margin:0;padding:0 10px;color:#365740;background:#e1ebdd;border-radius:10px;font-size:12px;line-height:30px}

.controls{background:#fffdf7;border:1px solid #d9ccb3;border-radius:14px;padding:12px;margin:10px 0 16px}
.usage{color:#365740;font-size:13px;margin-bottom:9px}
.pass{background:#f2eee3;padding:6px 10px;border-radius:8px;font-size:14px}
.setting-row,.intervals{display:flex;align-items:center}
.setting-row{justify-content:space-between;min-height:40px;font-size:14px}
.setting-btn{margin:0 0 0 3px;padding:0 7px;line-height:28px;font-size:12px;background:#e4ebdf;border-radius:8px;color:#34573e}
.setting-btn::after{border:0}
.chosen{background:#365740;color:white}
